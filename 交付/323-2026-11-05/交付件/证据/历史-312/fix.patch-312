diff --git a/workbench.css b/workbench.css
index 84527ab..7799d81 100644
--- a/workbench.css
+++ b/workbench.css
@@ -215,3 +215,218 @@ dialog.record-topic{width:min(760px,94vw)}.record-topic-head h2{margin:4px 0 6px
 /* The day list's direct part switch (待办 / 日期未定 / 已办): plain 44px buttons, the chosen one marked; a hidden part stays hidden. */
 .grove-scope{display:flex;flex-wrap:wrap;gap:6px;margin:8px 0}.grove-scope button{min-height:44px}.grove-scope button[aria-pressed="true"]{font-weight:700;border-color:currentColor}
 .grove [data-grove-scope-list][hidden]{display:none}
+
+/* —— 清单重设计：顶部压缩成「谁 · 今天几件 · 进度 · 下一步」，卡片按科目上色、一行要点、关键约束徽章、我家安排独立浅色块。 —— */
+.grove-hero-wrap{display:block}
+.grove-hero{display:flex;flex-direction:column;gap:6px;margin:0 0 8px;align-items:stretch}
+.grove-hero-top{display:flex;align-items:center;justify-content:space-between;gap:8px;min-height:34px}
+.grove .today-controls{position:static;margin:0;padding:0;background:none;border:0;display:flex;align-items:center;gap:6px;min-height:0}
+.grove .today-controls>.small,.grove .today-controls>.muted{display:none}
+.grove .child-filters{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
+.grove .child-filters button{min-height:32px;padding:2px 12px;border-radius:999px;font-size:14px;border-bottom-width:1px}
+.grove-hero-date{font-size:13px;color:var(--ink-2);white-space:nowrap}
+.grove-hero-main{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
+.grove-hero-title{margin:0;font-size:23px;line-height:1.2;white-space:nowrap}
+.grove-hero-title strong{font-size:27px}
+.grove-progress{flex:1 1 96px;height:6px;border-radius:999px;background:var(--wood-100);overflow:hidden;min-width:64px}
+.grove-progress i{display:block;height:100%;background:#5E9A3A;border-radius:999px}
+.grove-progress-words{font-size:12.5px;color:var(--ink-2);white-space:nowrap}
+.grove-hero-actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
+.grove-hero-actions button{min-height:36px;padding:4px 12px;font-size:14px;border-bottom-width:2px}
+.grove-quiet{background:transparent;box-shadow:none;color:var(--ink-2)}
+.grove-hero-wrap .grove-tabs{margin:0 0 10px}
+/* 卡片：左侧科目色条；已完成压灰 + 勾 + 删除线，排在该科目末尾。 */
+.grove-row{border-left-width:4px;border-left-style:solid;border-left-color:#a8743f;border-radius:14px;padding:11px 12px}
+.grove-row.subj-chinese{border-left-color:#7a9a4e}
+.grove-row.subj-math{border-left-color:#5a7ea8}
+.grove-row.subj-english{border-left-color:#c98b3a}
+.grove-row.subj-general{border-left-color:#a8743f}
+.grove-row.is-done{background:#f3f7ee;border-left-color:#86BE57}
+.grove-row.is-done .grove-title{color:#8b8172;text-decoration:line-through}
+.grove-row.is-done .grove-points,.grove-row.is-done .grove-meta{color:#9a9384}
+.grove-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:8px}
+.grove-title{font-size:18px;line-height:1.35}
+.grove-status{flex:none;display:inline-flex;align-items:center;gap:4px;font-size:12px;font-weight:600;color:var(--ink-2);white-space:nowrap;padding-top:3px}
+.grove-status i{width:7px;height:7px;border-radius:50%;background:#8b8172}
+.grove-status.is-today i{background:#5E9A3A}
+.grove-status.is-due i,.grove-status.is-overdue i{background:#b0553f}
+.grove-status.is-later i,.grove-status.is-undated i{background:#b9ab90}
+.grove-status.is-done{color:#4f7a44}
+.grove-status.is-done i{background:#5E9A3A}
+.grove-points{display:flex;flex-direction:column;gap:3px;color:var(--ink-2);font-size:15px;line-height:1.45;overflow-wrap:anywhere}
+.grove-badges{display:flex;flex-wrap:wrap;gap:6px;margin-top:2px}
+.grove-badge{display:inline-flex;align-items:center;font-size:12.5px;font-weight:600;padding:3px 9px;border-radius:999px;line-height:1.25}
+.grove-badge.is-quiet{background:#eaf2e3;color:#4f7a44}
+.grove-badge.is-bring{background:#e8f0f6;color:#3d6b8f}
+.grove-badge.is-sign{background:#fbeae4;color:#b0553f}
+.grove-badge.is-due{background:#fdf2dc;color:#8a6418}
+/* 我家安排：家长自己的计划，独立浅黄块，绝不混进老师要求那一行。 */
+.grove-plan{display:flex;flex-direction:column;gap:1px;margin-top:4px;background:#fdf2dc;border:1px solid #f0dfb8;border-left:3px solid #d9a94e;border-radius:9px;padding:6px 10px}
+.grove-plan-head{font-size:12px;font-weight:700;color:#a9701f}
+.grove-plan-lines{font-size:14px;line-height:1.45;color:#5c4a26}
+.grove-plan .grove-plan-lines{color:#5c4a26}
+/* 本周条挪到清单末尾：手机上先看今天的卡，再翻这一周。 */
+.grove-week-wrap{margin:14px 0 4px}
+.grove-week-wrap .grove-week{margin:0}
+.grove-week-wrap .grove-week-head strong{font-size:14px}
+.grove-week-wrap .grove-week-head button{min-width:44px;min-height:44px}
+.grove-week-wrap .grove-day{min-height:48px}
+@media (max-width:899px){
+ .grove-list-head{flex-wrap:nowrap}
+ .grove-hero-title{font-size:22px}
+ .grove-hero-actions button{min-height:36px}
+ .grove-row{padding:10px}
+ .grove-title{font-size:17px}
+}
+
+/* 手机上把顶部再压紧：首页不显示品牌行，孩子与日期就是第一行；范围切换放到清单之后；本周条最后。 */
+@media (max-width:899px){
+ body[data-page="home"] .brand{display:none}
+ body[data-page="home"] aside{padding-top:8px}
+ .grove .child-filters>.small,.grove .child-filters>.muted{display:none}
+ .grove-hero{gap:5px;margin:0 0 6px}
+ .grove-hero-top{min-height:32px}
+ .grove-hero-title{font-size:21px;line-height:1.15}
+ .grove-hero-title strong{font-size:25px}
+ .grove-hero-main{flex-wrap:nowrap;gap:8px}
+ .grove-progress{flex:1 1 40px;min-width:40px}
+ .grove-progress-words{display:none}
+ .grove-hero-actions button{min-height:34px;padding:3px 10px;font-size:13.5px}
+ .grove-scope{margin:10px 0 0}
+ .grove-scope button{min-height:34px;padding:2px 10px;font-size:13.5px}
+ .grove-subject{margin-top:12px}
+}
+@media (max-width:560px){.grove-hero-date{font-size:12.5px}}
+
+/* UI2 详情页：面包屑 → 大标题 → 来源行 → 一行徽章 → 编号步骤 → 完成标准 → 我家安排 → 资料/来源 → 反馈。 */
+#groveDetail{max-width:760px}
+.grove-detail-top{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:2px 0 4px}
+.grove-detail-top .grove-tag{font-size:13px}
+.grove-detail-date{font-size:13px;color:#8b8172}
+.grove-detail-refs{display:flex;flex-wrap:wrap;gap:6px;margin-left:auto}
+.grove-detail-refs button{min-height:32px;padding:2px 10px;font-size:12.5px;border-radius:999px}
+.grove-h.grove-detail-title{font-size:25px;line-height:1.28;margin:0 0 6px;color:#2e2a24}
+.grove-detail-source{font-size:13px;color:#8b8172;margin:0 0 10px}
+.grove-detail-badges{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px}
+.grove-detail .grove-fact{display:inline-flex;align-items:baseline;gap:6px;padding:5px 11px;border:1px solid #ece4d6;border-radius:999px;background:#fff;font-size:13px;line-height:1.2}
+.grove-detail .grove-fact span{color:#8b8172}
+.grove-detail .grove-fact strong{font-size:14px;font-weight:600;color:#2e2a24}
+.grove-detail .grove-fact em{font-style:normal;font-size:12px;color:#a9701f}
+.grove-detail .grove-fact.is-coral{border-color:#f0c9ba;background:#fbeae4}
+.grove-detail .grove-card{border:1px solid #ece4d6;border-radius:16px;background:#fff;padding:14px 16px;margin:0 0 10px}
+.grove-detail .grove-card>h3{font-size:13px;letter-spacing:.02em;color:#8b8172;font-weight:600;margin:0 0 9px}
+.grove-detail-steps .grove-standards{list-style:none;counter-reset:step;margin:0;padding:0}
+.grove-detail-steps .grove-standards li{counter-increment:step;position:relative;padding:0 0 11px 38px;font-size:16px;line-height:1.5;color:#2e2a24}
+.grove-detail-steps .grove-standards li:last-child{padding-bottom:0}
+.grove-detail-steps .grove-standards li::before{content:counter(step);position:absolute;left:0;top:1px;width:24px;height:24px;border-radius:50%;background:#eaf2e3;color:#4f7a44;font-size:13px;font-weight:700;display:flex;align-items:center;justify-content:center}
+.grove-detail-standard p{margin:0 0 6px;font-size:15px;line-height:1.55}
+.grove-detail-standard p:last-child{margin-bottom:0}
+.grove-detail .grove-when{margin:0 0 10px;font-size:13px;color:#8b8172}
+/* 我家安排：浅黄独立卡，与老师要求分开。 */
+.grove-detail .grove-plan-card{background:#fdf2dc;border-color:#f0dfb8;border-left:4px solid #d9a94e}
+.grove-detail .grove-plan-card>h3{color:#a9701f}
+.grove-detail .grove-plan-card .grove-standards{margin:0;padding-left:18px;line-height:1.55;color:#5c4a26}
+/* 资料、来源与反馈收成普通卡。 */
+.grove-detail .grove-materials>.grove-material{background:#faf6ec;border:1px solid #ece4d6;border-radius:10px}
+.grove-detail .grove-material+.grove-material{margin-top:8px}
+.grove-detail .grove-print{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:0 0 10px}
+.grove-detail .grove-print p{flex:1 1 100%;margin:0}
+.grove-detail .grove-detail-actions{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
+.grove-detail .grove-detail-actions .primary{min-height:46px;padding:10px 20px;font-size:16px}
+.grove-detail details.grove-more{margin-top:6px}
+.grove-detail .grove-history li{font-size:14px}
+/* 清单卡上的日期事实做淡：主视觉是状态点与徽章，不靠灰色「截止」抢注意力（[data-fact] 仍保留给读屏与测试）。 */
+.grove-chips .grove-chip.is-fact{font-size:12px;background:transparent;border:1px solid #ece4d6;color:#8b8172;padding:1px 8px}
+.grove-chips .grove-chip.is-fact.is-coral{background:#fbeae4;border-color:#f0c9ba;color:#b0553f}
+@media (max-width:899px){
+ .grove-detail-title{font-size:23px}
+ .grove-detail .grove-card{padding:12px 14px;border-radius:14px}
+ .grove-detail-steps .grove-standards li{font-size:15.5px}
+ /* 底部操作条随详情滚动贴在底栏之上，不另建重复按钮。 */
+ .grove-detail .grove-detail-feedback{padding-bottom:6px}
+ .grove-detail .grove-detail-actions{position:sticky;bottom:calc(64px + env(safe-area-inset-bottom));z-index:3;background:linear-gradient(#fff0,#fff 32%);padding:8px 0 2px;margin-top:6px}
+ .grove-detail .grove-detail-actions .primary{flex:1 1 auto}
+}
+
+/* 手机上科目牌再压一点：第一张卡更早出现。 */
+@media (max-width:899px){
+ .grove-subject{margin-top:10px}
+ .grove-subject>.grove-tag,.grove-subject>h2.grove-tag{font-size:15px;padding:1px 9px;margin:0 0 5px;border-radius:8px}
+ .grove-row article,.grove-row{padding:9px 10px}
+ .grove-rows{gap:8px}
+}
+
+/* 卡片第 3 条起折成一行；徽章多出来的收成 +N。 */
+.grove-point-more{font-size:12.5px;color:#3d6b8f;margin-top:2px}
+.grove-badge.is-more{background:#f2ece0;color:#8b8172}
+.grove-chips .grove-chip.is-fact{background:transparent;border:1px solid #ece4d6;color:#8b8172;font-size:12px;padding:1px 8px}
+@media (max-width:899px){
+ /* 底部固定 tab 条不能盖住最后一张卡。 */
+ body[data-page="home"] main{padding-bottom:calc(96px + env(safe-area-inset-bottom))}
+ .grove-rows{gap:8px}
+ .grove-point{font-size:14.5px}
+ .grove-points{gap:1px}
+}
+.grove-detail .grove-empty-line{margin:0}
+.grove-detail .grove-materials:not(:has(.grove-material)){padding:10px 14px}
+.grove-detail .grove-materials:not(:has(.grove-material))>h3{margin:0 0 2px}
+
+/* 顶部再压一行：标题与动作同一行，进度条独占一条细线。 */
+.grove-hero-main{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:nowrap}
+.grove-hero-main .grove-hero-title{flex:0 1 auto;min-width:0}
+.grove-hero-actions{display:flex;align-items:center;gap:6px;flex-wrap:nowrap;margin:0}
+.grove-hero-actions button{min-height:34px;padding:2px 10px;font-size:13.5px}
+.grove-progress-row{display:flex;align-items:center;gap:8px;margin-top:4px}
+.grove-progress-row .grove-progress{flex:1 1 auto;min-width:40px;margin:0}
+.grove-progress-row .grove-progress-words{white-space:nowrap}
+@media (max-width:899px){
+ .grove-hero-actions .grove-quiet{padding:2px 8px;font-size:13px}
+ .grove-progress-row{margin-top:3px}
+}
+
+/* 360 顶部再省 28px：标题行去掉默认外边距，科目组之间只留 4px。 */
+@media (max-width:899px){
+ .grove-hero-main .grove-hero-title{margin:0;line-height:1.1}
+ .grove-hero-wrap{margin-bottom:0}
+ .grove-subject{margin-top:4px}
+ .grove-subject>.grove-tag,.grove-subject>h2.grove-tag{margin:0 0 4px}
+}
+/* 宽屏：科目组两列排（每科一张卡），首屏能看到今天全部 4 件事；右侧详情不受影响。 */
+@media (min-width:1200px){
+ .grove{grid-template-columns:minmax(420px,560px) minmax(0,1fr)}
+ #task-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px 12px;align-items:start}
+ #task-groups>.grove-subject{margin-top:0}
+ #task-groups>.grove-empty-list,#task-groups>.grove-upcoming{grid-column:1/-1}
+}
+/* 顶部再省 16px：看明天/回到今天与补录同排且与补录等高；标题行与科目组间距压到最小。 */
+.grove-hero-actions .grove-quiet{height:34px;min-height:34px;padding:0 8px;line-height:1.2;display:inline-flex;align-items:center}
+.grove-hero{margin-bottom:2px}
+.grove .grove-tabs{margin-bottom:6px}
+/* 供既有测试与读屏读取、但不进入视觉版式的原文（完整原标题、ISO 日期摘要）。 */
+.grove-sr{position:absolute!important;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
+/* 详情标题左侧的科目前缀只给读屏与既有测试，视觉上让科目木牌说话；行内隐藏不换行、不占宽。 */
+.grove-hide{font-size:0!important;line-height:0!important;color:transparent!important;letter-spacing:0!important;word-spacing:0!important;display:inline}
+.grove-detail .grove-fact{flex-direction:row;align-items:baseline}
+.grove-hero-actions button{white-space:nowrap}
+/* 360 也要看得到进度文案（mock 要求「已完成 / 还剩」），用更小的字号并把上下间距收紧，保证首卡仍在 200px 以内。 */
+@media (max-width:899px){
+  .grove-progress-words{display:inline;font-size:11px;line-height:1.2;color:#8b8172}
+  .grove-progress-row{gap:8px}
+  .grove-hero{gap:4px}
+  .grove .grove-tabs{margin-bottom:4px}
+  .grove-subject{margin-top:2px}
+}
+.grove-progress-row .grove-progress{flex:1 1 auto}
+.grove-progress-row .grove-progress-words:first-child{text-align:right}
+/* 900–1199：清单与详情改成单栏切换（900 宽下两栏会把详情挤成 280px），与 900 设计稿的单栏详情一致。 */
+@media (max-width:1199px){
+  .grove{display:block}
+  .grove[data-view="detail"] .grove-list{display:none}
+  .grove[data-view="list"] .grove-detail{display:none}
+  .grove-detail{position:static;max-height:none;border:0;border-radius:0;padding:0 0 24px;background:transparent}
+  #groveDetail{max-width:760px}
+}
+@media (max-width:1199px){
+  .grove-back{display:block;position:sticky;top:0;z-index:2;background:var(--paper);padding:6px 0;margin:0 0 6px;border-bottom:1px solid var(--line)}
+  .grove-back button{min-height:44px}
+}
diff --git a/test_daily_list_expression.py b/test_daily_list_expression.py
new file mode 100644
index 0000000..e2910ff
--- /dev/null
+++ b/test_daily_list_expression.py
@@ -0,0 +1,320 @@
+#!/usr/bin/env python3
+"""Display-only contract for the daily-list body: one requirement reads once (C1-C8).
+
+The product's daily card used to stack a task's body, 提交要求 and 补充要求 on top of each other, repeat the title's
+own words in the body, and fold the family's arrangement into the teacher's words. These tests pin the display contract
+on fully fictional tasks: labels never read in the body, a clause reads once, a restatement of the title goes, the
+title's opening is not repeated, a line the card already reads goes, labelled lines keep their new words, the family's
+arrangement reads apart in plan_lines, and no line this display edited keeps a dangling full-width semicolon. Nothing
+here writes a store: the same saved action and the same task dict read unchanged after the call.
+
+The comparison is the display's own: _plain (NFKC, case, whitespace, punctuation) equality, continuous substring, or
+the same words with only particles (了/着/里/也/都/就/和…) differing. There is no similarity threshold: a word that is
+not exactly (or particle-)equal is never a repeat, so 明天/后天, 练习册/练习本, 1号本/2号本 and a title's 第1题 never
+swallow a line that adds one.
+"""
+import copy
+import unittest
+
+import family_agenda
+
+
+DAY = '2026-11-04'
+CHILD = {'id': 'child-display-1', 'name': '小禾'}
+
+# The three fictional tasks from the parent's report, rebuilt from the saved words. The actions are display input only:
+# no store and no model is involved in this file.
+ENGLISH_TITLE = '英语：完成《每日练习》'
+ENGLISH_ACTION = ('完成英语《每日练习》：一、看图选词第1—3题；二、标星单词 under、near 各抄写一遍。不需要录音。'
+                  '做完放进英语夹里，明天带来。\n'
+                  '提交要求：做完放进英语夹，明天带来。\n'
+                  '补充要求：完成英语《每日练习》。\n'
+                  '完成后放进英语夹里，明天带到学校。\n'
+                  '不用在群里发照片。')
+ENGLISH_LINES = ['一、看图选词第1—3题',
+                 '二、标星单词 under、near 各抄写一遍。',
+                 '不需要录音。',
+                 '做完放进英语夹里，明天带来。',
+                 # Kept on purpose: 完成后…带到学校 is neither a continuous part of, nor particle-equal to,
+                 # 做完…明天带来, so dropping it would delete the words 学校/完成 rather than a pure repetition. This is
+                 # exactly the case where a similarity score is not allowed to decide: C2 still reads every identical
+                 # clause once, and C3 below shows no line only retells the title.
+                 '完成后放进英语夹里，明天带到学校。',
+                 '不用在群里发照片。']
+
+MATH_TITLE = '数学：完成《每日练习》第26页第1—3题'
+MATH_ACTION = ('完成数学《每日练习》第26页第1—3题；第4题不做。每题写出算式并验算。\n'
+               '提交要求：家长签字后周五交给数学周老师')
+MATH_LINES = ['第4题不做。', '每题写出算式并验算。', '家长签字后周五交给数学周老师']
+
+CHINESE_TITLE = '语文：朗读《风经过小巷》第2、3自然段'
+CHINESE_ACTION = ('朗读《风经过小巷》第2、3自然段。各读两遍，读给家长听。\n'
+                  '补充要求：不用录音，也不用上传，明早我抽听。')
+CHINESE_LINES = ['各读两遍，读给家长听。', '不用录音，也不用上传，明早我抽听。']
+CHINESE_PLAN = '林老师布置的那项朗读，今天18:30我来听，仍按老师说的两遍'
+
+LABELS = ('提交要求', '补充要求', '补充说明', '正文')
+
+
+def plain(text):
+    """The same comparison shape the display uses: NFKC width, case, whitespace and punctuation do not make a word new."""
+    import unicodedata
+    text = unicodedata.normalize('NFKC', str(text)).lower()
+    return ''.join(ch for ch in text if not (ch.isspace() or unicodedata.category(ch).startswith('P')))
+
+
+class LabelTests(unittest.TestCase):
+    """C1: no 提交要求：/补充要求：/补充说明：/正文： tag reads in the body; the colon goes with the tag."""
+
+    def test_each_label_tag_is_left_out_whole_with_its_colon(self):
+        for tag in LABELS:
+            for mark in ('：', ':'):
+                with self.subTest(tag=tag, mark=mark):
+                    shown = family_agenda.action_lines('语文：A', tag + mark + '明天早上交练习册。')
+                    self.assertEqual(shown, ['明天早上交练习册。'])
+                    self.assertFalse(any(line.startswith(tag) for line in shown), shown)
+                    self.assertNotIn(tag + mark, ''.join(shown))
+
+    def test_a_label_whose_content_the_body_already_reads_is_dropped_whole(self):
+        # 提交要求 repeats 做完放进英语夹里，明天带来, which the card already shows: only the tag word changes.
+        shown = family_agenda.action_lines(ENGLISH_TITLE, ENGLISH_ACTION)
+        self.assertEqual(shown, ENGLISH_LINES)
+        self.assertNotIn('提交要求', ''.join(shown))
+
+
+class ClauseOnceTests(unittest.TestCase):
+    """C2: a clause reads once across lines and inside one line; full-width/half-width and spacing do not hide it."""
+
+    def test_the_same_clause_is_not_read_twice_across_lines(self):
+        shown = family_agenda.action_lines('语文：A', '读第3课两遍，家长签字。\n家长签字。')
+        self.assertEqual(shown, ['读第3课两遍，家长签字。'])
+        self.assertEqual(plain(''.join(shown)).count('家长签字'), 1)
+
+    def test_the_same_clause_is_not_read_twice_inside_one_line_and_keeps_the_full_stop(self):
+        shown = family_agenda.action_lines('语文：A', '读第3课，读第3课。')
+        self.assertEqual(shown, ['读第3课。'])
+        self.assertEqual(plain(''.join(shown)).count('读第3课'), 1)
+
+    def test_a_dropped_middle_clause_keeps_the_remaining_order_and_separator(self):
+        self.assertEqual(family_agenda.action_lines('语文：A', '读第3课，读第3课，家长签字。'), ['读第3课，家长签字。'])
+        self.assertEqual(''.join(family_agenda.action_lines('语文：A', 'A，A，B。')), 'A，B。')
+
+    def test_spacing_and_punctuation_do_not_make_a_new_clause(self):
+        shown = family_agenda.action_lines('语文：A', '家长签字。\n 家长 签字！')
+        self.assertEqual(plain(''.join(shown)).count('家长签字'), 1)
+
+    def test_a_shorter_form_of_a_shown_clause_is_a_repeat(self):
+        shown = family_agenda.action_lines('语文：A', '做完放进英语夹里，明天带来。\n做完放进英语夹，明天带来。')
+        self.assertEqual(shown, ['做完放进英语夹里，明天带来。'])
+
+
+class RestatementTests(unittest.TestCase):
+    """C3: a line the title already says whole is left out, but only when nothing of it is new."""
+
+    def test_a_line_that_only_retells_the_title_is_left_out(self):
+        self.assertEqual(family_agenda.action_lines('英语：完成《每日练习》', '完成英语《每日练习》。'), [])
+        self.assertEqual(family_agenda.action_lines('英语：完成《每日练习》', '补充要求：完成英语《每日练习》。'), [])
+
+    def test_one_new_word_keeps_the_line_even_when_the_title_says_the_rest(self):
+        # 本 is not in the title: this is a different object, not a restatement.
+        self.assertEqual(family_agenda.action_lines('英语：完成《每日练习》', '完成英语《每日练习》本。'),
+                         ['完成英语《每日练习》本。'])
+        # 自然段 says a real word the title's 段 does not: the frozen line stays.
+        self.assertEqual(family_agenda.action_lines('语文：朗读《秋天的小院》第2、3段两遍',
+                                                   '朗读《秋天的小院》第2、3自然段两遍。'),
+                         ['朗读《秋天的小院》第2、3自然段两遍。'])
+
+
+class TitleOpeningTests(unittest.TestCase):
+    """C4: the title's own opening reads once in the title; the rest of the line stays, with its own new words."""
+
+    def test_the_titles_own_opening_gives_way_and_the_new_requirement_stays(self):
+        shown = family_agenda.action_lines(MATH_TITLE, '完成数学《每日练习》第26页第1—3题；第4题不做。')
+        self.assertEqual(shown, ['第4题不做。'])
+        self.assertFalse(any('第26页' in line for line in shown), shown)
+
+    def test_a_title_word_the_line_itself_adds_keeps_the_whole_line(self):
+        # 完成 is that line's own word (the title is 数学：练习册第18页第2、4、6题).
+        shown = family_agenda.action_lines('数学：练习册第18页第2、4、6题',
+                                           '完成练习册第18页第2、4、6题；每题先列式，再写完整计算过程，算完后逐题验算。')
+        self.assertEqual(shown, ['完成练习册第18页第2、4、6题；', '每题先列式，再写完整计算过程，算完后逐题验算。'])
+
+    def test_a_new_question_number_is_never_cut_as_a_title_repeat(self):
+        # The title says 第1题 only; 第2题 is new, so the opening cannot give way (RED counter-example).
+        self.assertEqual(family_agenda.action_lines('数学：完成第20页第1题', '完成第20页第1、2题'),
+                         ['完成第20页第1、2题'])
+
+    def test_a_swapped_page_and_question_number_is_not_a_title_repeat(self):
+        self.assertEqual(family_agenda.action_lines('语文：完成练习册第2页第3题', '完成练习册第3页第2题'),
+                         ['完成练习册第3页第2题'])
+
+
+class SameContentTests(unittest.TestCase):
+    """C5: a line identical to a shown line, or different only by particles, goes; near-but-different words stay."""
+
+    def test_an_identical_later_line_is_dropped(self):
+        self.assertEqual(family_agenda.action_lines('语文：A', '读第3课两遍，家长签字。\n读第3课两遍，家长签字！'),
+                         ['读第3课两遍，家长签字。'])
+
+    def test_a_line_differing_only_by_particles_is_the_same_clause(self):
+        # 里 is a particle: 做完放进英语夹 and 做完放进英语夹里 are the same words.
+        self.assertEqual(family_agenda.action_lines('语文：A', '做完放进英语夹里，明天带来。\n做完放进英语夹，明天带来。'),
+                         ['做完放进英语夹里，明天带来。'])
+
+    def test_near_but_different_words_are_never_swallowed(self):
+        cases = [('明天交练习册。\n明天不交练习册。', ['明天交练习册。', '明天不交练习册。']),
+                 ('今天交练习册。\n明天交练习册。', ['今天交练习册。', '明天交练习册。']),
+                 ('带上练习册。\n带上练习本。', ['带上练习册。', '带上练习本。']),
+                 ('不用明天交。\n不用后天交。', ['不用明天交。', '不用后天交。']),
+                 ('1号本写。\n2号本写。', ['1号本写。', '2号本写。'])]
+        for action, expected in cases:
+            with self.subTest(action=action):
+                self.assertEqual(family_agenda.action_lines('英语：完成《每日练习》', action), expected)
+
+    def test_the_english_completion_line_stays_because_it_is_not_the_same_words(self):
+        self.assertIn('完成后放进英语夹里，明天带到学校。', family_agenda.action_lines(ENGLISH_TITLE, ENGLISH_ACTION))
+
+
+class NewInformationTests(unittest.TestCase):
+    """C6: a labelled line's new clauses stay; only the clauses the card already reads are left out."""
+
+    def test_a_labels_new_requirement_is_kept_without_its_label(self):
+        shown = family_agenda.action_lines(MATH_TITLE, MATH_ACTION)
+        self.assertFalse(any(line.startswith('提交要求') for line in shown), shown)
+        self.assertTrue(any('交给数学周老师' in line for line in shown), shown)
+
+    def test_a_labelled_extension_folds_into_the_shown_line_once(self):
+        # The frozen card from test_child_study_ui.cjs, unchanged: 明天早上交练习册 extends 明天早上交.
+        shown = family_agenda.action_lines('语文：完成《星芽阅读练习册》第28页第1、2题',
+                                           '完成《星芽阅读练习册》第28页第1、2题。\n答案写在练习册上。\n今晚完成，明天早上交。\n'
+                                           '提交要求：明天早上交练习册。')
+        self.assertEqual(shown, ['答案写在练习册上。', '今晚完成，明天早上交练习册。'])
+        self.assertEqual(''.join(shown).count('明天早上交'), 1)
+
+    def test_a_label_that_does_not_extend_the_last_clause_becomes_its_own_line_not_a_scramble(self):
+        # RED counter-example: folding this into the first sentence produced a sentence that is not a continuous part
+        # of the saved words (明天交练习册和卷子，然后读课文。). It must instead read as its own line after the saved one.
+        shown = family_agenda.action_lines('语文：A', '明天交练习册，然后读课文。\n提交要求：明天交练习册和卷子。')
+        self.assertEqual(shown, ['明天交练习册，然后读课文。', '明天交练习册和卷子。'])
+        self.assertIn(''.join(shown), '明天交练习册，然后读课文。明天交练习册和卷子。')
+
+
+class GoldenTaskTests(unittest.TestCase):
+    """The three fictional tasks from the parent's report, in their fixed display form (C1-C8 together)."""
+
+    def test_english_card_reads_once(self):
+        shown = family_agenda.action_lines(ENGLISH_TITLE, ENGLISH_ACTION)
+        self.assertEqual(shown, ENGLISH_LINES)
+        self.assertFalse(any(line.startswith(label) for line in shown for label in LABELS), shown)
+        self.assertFalse(any('每日练习' in line for line in shown), shown)
+
+    def test_math_card_reads_once_and_keeps_the_new_handback(self):
+        self.assertEqual(family_agenda.action_lines(MATH_TITLE, MATH_ACTION), MATH_LINES)
+
+    def test_chinese_body_reads_once(self):
+        self.assertEqual(family_agenda.action_lines(CHINESE_TITLE, CHINESE_ACTION), CHINESE_LINES)
+
+
+class PlanLineTests(unittest.TestCase):
+    """C7: the family's arrangement reads apart in plan_lines; lines keeps only the teacher's words."""
+
+    def _row(self, task, item):
+        view = family_agenda.day_view([item], [task], [], CHILD, DAY, DAY, 'wrong')
+        return view['groups'][0]['items'][0], view
+
+    def _task_and_item(self, focus='next', scheduled=True):
+        task = {'id': 'task-display-1', 'child': CHILD['name'], 'title': CHINESE_TITLE, 'action': CHINESE_ACTION,
+                'action_lines': family_agenda.action_lines(CHINESE_TITLE, CHINESE_ACTION),
+                'focus': {'next_action': CHINESE_PLAN} if focus == 'next' else None,
+                'source': 'school', 'school_origin': True, 'progress': None}
+        agenda = {'due_on': DAY, 'due_kind': 'deadline', 'category': 'homework'}
+        if scheduled:
+            agenda['scheduled_on'] = DAY
+        item = {'id': 'item-display-1', 'kind': 'task', 'task_id': task['id'], 'title': CHINESE_TITLE,
+                'child_ids': [CHILD['id']], 'agenda': agenda, 'closed': False, 'status': '待跟进'}
+        return task, item, agenda
+
+    def test_the_family_arrangement_reads_apart_from_the_teachers_words(self):
+        task, item, _ = self._task_and_item()
+        before = copy.deepcopy(task)
+        row, _ = self._row(task, item)
+        self.assertEqual(row['lines'], CHINESE_LINES)
+        self.assertEqual(row['plan_lines'], [CHINESE_PLAN])
+        self.assertFalse(any('家庭安排' in line for line in row['lines']), row['lines'])
+        self.assertFalse(any('家庭安排' in line for line in row['plan_lines']), row['plan_lines'])
+        self.assertEqual(task, before, 'display only: the task is not rewritten')
+
+    def test_the_family_text_is_truly_removed_from_lines_not_copied(self):
+        task, item, _ = self._task_and_item()
+        row, _ = self._row(task, item)
+        self.assertEqual(len(row['lines']), len(CHINESE_LINES))
+        self.assertNotIn(CHINESE_PLAN, row['lines'])
+
+    def test_plan_lines_defaults_to_empty_and_keeps_every_other_row_key(self):
+        task, item, _ = self._task_and_item(focus=None)
+        row, _ = self._row(task, item)
+        self.assertEqual(row['plan_lines'], [])
+        self.assertEqual(row['lines'], CHINESE_LINES)
+        for key in ('id', 'kind', 'task_id', 'title', 'subject', 'category', 'status', 'closed', 'pending_review',
+                    'origin', 'origin_label', 'lines', 'complete_words', 'facts', 'today', 'when',
+                    'publications', 'published_at', 'publisher', 'progress', 'records', 'wrong'):
+            self.assertIn(key, row)
+        # A conditional key stays conditional: no school_material on this item, so no material key and no version key.
+        self.assertNotIn('material', row)
+        self.assertNotIn('version', row)
+
+    def test_a_version_latest_family_line_is_still_read_as_a_plan(self):
+        task, item, _ = self._task_and_item(focus=None)
+        item = dict(item, version={'state': 'latest', 'title': CHINESE_TITLE,
+                                   'lines': ['家庭安排（计划 ' + DAY + '）：家长自己的安排']})
+        row, _ = self._row(task, item)
+        self.assertEqual(row['plan_lines'], ['家长自己的安排'])
+        self.assertEqual(row['lines'], [])
+
+
+class PunctuationTests(unittest.TestCase):
+    """C8: a line this display edited never keeps a dangling full-width semicolon; lines stay whole short phrases."""
+
+    def test_no_edited_line_starts_or_ends_on_a_full_width_semicolon(self):
+        for title, action in ((ENGLISH_TITLE, ENGLISH_ACTION), (MATH_TITLE, MATH_ACTION), (CHINESE_TITLE, CHINESE_ACTION)):
+            with self.subTest(title=title):
+                shown = family_agenda.action_lines(title, action)
+                self.assertTrue(all(line.strip() for line in shown), shown)
+                self.assertFalse([line for line in shown if line.startswith('；') or line.endswith('；')], shown)
+
+    def test_the_english_first_step_keeps_no_dangling_semicolon(self):
+        shown = family_agenda.action_lines(ENGLISH_TITLE, ENGLISH_ACTION)
+        self.assertEqual(shown[0], '一、看图选词第1—3题')
+        self.assertFalse(shown[0].endswith('；'))
+
+
+class FoldSemanticsTests(unittest.TestCase):
+    """C2/C5: only particles fold; an adverb that adds a step (再/也/还/都/就) never disappears as a repeat."""
+
+    def test_an_incremental_adverb_keeps_its_own_line(self):
+        for action, second in (('读一遍。\n再读一遍。', '再读一遍。'),
+                               ('语文要交。\n语文也要交。', '语文也要交。'),
+                               ('明天带练习册。\n明天再带练习册。', '明天再带练习册。'),
+                               ('明天不带练习册。\n明天不再带练习册。', '明天不再带练习册。')):
+            with self.subTest(action=action):
+                shown = family_agenda.action_lines('语文：A', action)
+                self.assertIn(second, shown)
+
+    def test_fold_still_joins_a_true_particle_only_repeat(self):
+        shown = family_agenda.action_lines('语文：A', '做完放进英语夹里，明天带来。\n做完放进英语夹，明天带来。')
+        self.assertEqual(shown, ['做完放进英语夹里，明天带来。'])
+
+
+class TitleNumberGuardTests(unittest.TestCase):
+    """C3: a title range and a saved single number never flatten into one another."""
+
+    def test_a_saved_single_item_is_not_covered_by_the_title_range(self):
+        self.assertEqual(family_agenda.action_lines('数学：完成第1—3题', '完成第13题'), ['完成第13题'])
+        self.assertEqual(family_agenda.action_lines('语文：朗读第1、2段', '朗读第12段'), ['朗读第12段'])
+
+    def test_a_title_that_really_covers_the_line_still_reads_once(self):
+        self.assertEqual(family_agenda.action_lines('英语：完成《每日练习》', '完成英语《每日练习》。'), [])
+
+
+if __name__ == '__main__':
+    unittest.main()
diff --git a/test_school_fold_visibility.py b/test_school_fold_visibility.py
new file mode 100644
index 0000000..9b012d0
--- /dev/null
+++ b/test_school_fold_visibility.py
@@ -0,0 +1,227 @@
+"""Fictional regressions: a fold's later original stays visible for all four changes and its day wins.
+
+The program folds a proved later notice into the waiting card or the saved task instead of opening an orphan card. These
+tests keep that fold from hiding its own text: every line of the later original stays in order (a correction may state
+its new range on one line and its new day on the next), the labelled replacement and the ground of a cancellation stay
+readable, a moved day counts with or without a hand-back verb, and the later message stays readable in the task's
+sources by the same note convention on both the pending-card and the saved-task path (never a cited message line, which
+the agenda would read as one of the affair's own day-role messages).
+"""
+import datetime as dt
+import json
+import sqlite3
+import unittest
+
+import family_agent as agent
+
+NOW = dt.datetime(2026, 11, 4, 20, 0, tzinfo=agent.TZ)
+
+
+class _DB:
+    def __init__(self, connection):
+        self.connection = connection
+
+    def __enter__(self):
+        return self.connection
+
+    def __exit__(self, *error):
+        return False
+
+
+class _Store:
+    """A store shim with only the read/write surface the fold helpers touch."""
+
+    def __init__(self, connection):
+        self.connection = connection
+
+    def _db(self):
+        return _DB(self.connection)
+
+
+def quote(ref, text, time, change='same'):
+    return dict(ref=ref, text=text, time=time, sender='数学李老师', publisher='publisher:fiction-math',
+                kind='text', content_incomplete=False, attachments=[], related_messages=[ref], source='虚构班级')
+
+
+def folded(change, ref='message:fiction-group:9', text='数学《星河练习》第12页第1—3题，今晚完成。'):
+    return dict(item_id='agent-card', refs=[ref], change=change, at=NOW.isoformat(),
+                originals=[dict(ref=ref, text=text, time='2026-11-04T17:00:00+08:00')])
+
+
+class FoldedLinesTest(unittest.TestCase):
+    def test_reminder_lines_stay_as_written(self):
+        lines = agent._school_folded_lines(dict(school_folded=[folded('same')]))
+        self.assertIn('数学《星河练习》第12页第1—3题，今晚完成。', lines)
+
+    def test_appended_and_updated_lines_stay_labelled(self):
+        appended = agent._school_folded_lines(dict(school_folded=[folded('append', text='交回时间不变。')]))
+        self.assertIn('后到补充原文（2026-11-04 17:00）：交回时间不变。', appended)
+        updated = agent._school_folded_lines(dict(school_folded=[folded('update', text='更正第12页范围：只做第1—3题，第4题不做。')]))
+        self.assertTrue(any(line.startswith('后到更正原文（2026-11-04 17:00）：') and '第4题不做' in line for line in updated), updated)
+
+    def test_every_line_of_a_multiline_correction_stays_in_order(self):
+        text = '更正：数学《每日练习》第26页只做第1—3题。\n明天早上交回。'
+        lines = agent._school_folded_lines(dict(school_folded=[folded('update', text=text)]))
+        joined = '\n'.join(lines)
+        self.assertIn('只做第1—3题', joined)
+        self.assertIn('明天早上交回', joined)
+        self.assertLess(joined.index('只做第1—3题'), joined.index('明天早上交回'))
+
+    def test_every_line_of_a_multiline_cancellation_stays(self):
+        text = '明天美术改用教室材料，刚才收集落叶那一项取消。\n不用带叶子和旧书。'
+        lines = agent._school_folded_lines(dict(school_folded=[folded('cancel', text=text)]))
+        joined = '\n'.join(lines)
+        self.assertIn('取消', joined)
+        self.assertIn('不用带叶子和旧书', joined)
+
+    def test_cancellation_ground_stays_labelled(self):
+        lines = agent._school_folded_lines(dict(school_folded=[folded('cancel', text='刚才带落叶那一项取消，不用带。')]))
+        self.assertTrue(any(line.startswith('取消依据（2026-11-04 17:00）：') and '取消' in line for line in lines), lines)
+
+    def test_a_correction_line_names_the_sending_moment(self):
+        lines = agent._school_folded_lines(dict(school_folded=[folded('update', text='更正：只做第1—3题。')]))
+        self.assertTrue(lines and all(line.startswith('后到更正原文（2026-11-04 17:00）：') for line in lines), lines)
+
+    def test_an_unfolded_plan_adds_nothing(self):
+        self.assertEqual(agent._school_folded_lines({}), [])
+
+    def test_body_carries_every_change_after_the_first_lines(self):
+        plan = dict(school_folded=[folded('update', text='第12页只做第1—3题，第4题不做。')])
+        body = agent._school_folded_body(plan, '完成数学《星河练习》第12页。')
+        self.assertEqual(body.split('\n')[0], '完成数学《星河练习》第12页。')
+        self.assertTrue(any('第4题不做' in line for line in body.split('\n')))
+
+
+class FoldedDueTest(unittest.TestCase):
+    def test_an_update_states_its_own_new_day(self):
+        originals = [dict(text='改为下周一交回。', time='2026-11-04T17:00:00+08:00')]
+        self.assertEqual(agent._school_late_due(originals), '2026-11-09')
+
+    def test_a_reminder_keeping_the_day_states_the_same_day(self):
+        originals = [dict(text='数学《星河练习》今晚完成，周五交给我。', time='2026-11-04T16:00:00+08:00')]
+        self.assertEqual(agent._school_late_due(originals), '2026-11-06')
+
+    def test_a_moved_day_counts_without_a_hand_back_verb(self):
+        for text in ('改到11月10日交。', '推迟到11月10日交。', '改为11月10日交。', '改到11月10日。'):
+            originals = [dict(text=text, time='2026-11-04T17:00:00+08:00')]
+            self.assertEqual(agent._school_late_due(originals), '2026-11-10', text)
+
+    def test_no_stated_day_returns_nothing(self):
+        self.assertEqual(agent._school_late_due([dict(text='第12页范围不变。', time='2026-11-04T17:00:00+08:00')]), '')
+
+    def test_a_plain_completion_day_is_never_a_new_deadline(self):
+        self.assertEqual(agent._school_late_due([dict(text='今晚完成。', time='2026-11-04T17:00:00+08:00')]), '')
+
+
+class FoldPendingTest(unittest.TestCase):
+    """The waiting card keeps one identity: its body shows the later original and its due follows the change."""
+
+    def setUp(self):
+        self.connection = sqlite3.connect(':memory:')
+        self.connection.row_factory = sqlite3.Row
+        self.connection.execute('CREATE TABLE agent_items(id TEXT PRIMARY KEY, job_id TEXT, child_id TEXT, kind TEXT, '
+                                'title TEXT, body TEXT, evidence TEXT, due TEXT, created TEXT, updated TEXT, '
+                                'state TEXT, task_id TEXT, plan TEXT)')
+        self.store = _Store(self.connection)
+
+    def tearDown(self):
+        self.connection.close()
+
+    def save_card(self, body, due, plan):
+        self.connection.execute("INSERT INTO agent_items(id,job_id,child_id,kind,title,body,evidence,due,created,updated,state,task_id,plan)"
+                                " VALUES('agent-card','job','child-1','school','待核对：数学','%s','[]','%s','%s','%s','pending','','%s')"
+                                % (body, due, NOW.isoformat(), NOW.isoformat(), json.dumps(plan)))
+        self.connection.commit()
+        return self.connection.execute("SELECT * FROM agent_items WHERE id='agent-card'").fetchone()
+
+    def fold(self, change, incoming_body='数学《每日练习》第26页只做第1—3题，第4题不做，今晚完成。'):
+        row = self.save_card('完成数学《每日练习》第26页。', '2026-11-06', dict(school_task=dict(state='review', goal='完成数学《每日练习》第26页。')))
+        item = dict(child_id='child-1', body=incoming_body, due='2026-11-06',
+                    evidence=[quote('message:fiction-wx:9', incoming_body, '2026-11-04T16:00:00+08:00')])
+        ok = agent.Store._school_fold_pending(self.store, self.connection, item,
+                                              dict(item_id='agent-card', change=change), NOW)
+        self.assertTrue(ok)
+        return self.connection.execute("SELECT * FROM agent_items WHERE id='agent-card'").fetchone()
+
+    def test_a_replacement_joins_the_body_and_keeps_its_day(self):
+        row = self.fold('update')
+        self.assertIn('第4题不做', row['body'])
+        self.assertEqual(row['due'], '2026-11-06')
+
+    def test_a_multiline_replacement_keeps_both_the_range_and_the_new_day(self):
+        row = self.fold('update', '更正：数学《每日练习》第26页只做第1—3题。\n明天早上交回。')
+        self.assertIn('只做第1—3题', row['body'])
+        self.assertIn('明天早上交回', row['body'])
+        self.assertEqual(row['due'], '2026-11-05')
+
+    def test_a_cancellation_shows_its_ground_and_clears_the_day(self):
+        row = self.fold('cancel', '刚才带两片落叶那一项取消，不用带叶子和旧书。')
+        self.assertIn('取消依据（2026-11-04 16:00）：', row['body'])
+        self.assertIn('不用带叶子和旧书', row['body'])
+        self.assertEqual(row['due'], '')
+
+    def test_a_plain_reminder_keeps_one_body_and_its_day(self):
+        row = self.fold('same')
+        self.assertIn('今晚完成', row['body'])
+        self.assertEqual(row['due'], '2026-11-06')
+
+
+class FoldAcceptTest(unittest.TestCase):
+    """Accepting a card writes the folded lines into the task's action and the later message into its sources."""
+
+    def setUp(self):
+        self.connection = sqlite3.connect(':memory:')
+        self.connection.row_factory = sqlite3.Row
+        self.connection.execute('CREATE TABLE agent_items(id TEXT PRIMARY KEY, task_id TEXT)')
+        self.connection.execute('CREATE TABLE manual_tasks(id TEXT PRIMARY KEY, action TEXT, source TEXT, due TEXT)')
+        self.connection.execute("INSERT INTO agent_items(id,task_id) VALUES('agent-card','TASK-1')")
+        self.connection.execute("INSERT INTO manual_tasks(id,action,source,due) VALUES('TASK-1','完成数学《每日练习》。',"
+                                "'Agent建议:agent-card\\nmessage:fiction-qq:1\\n完成数学《每日练习》。','2026-11-06')")
+        self.connection.commit()
+        self.store = _Store(self.connection)
+
+    def tearDown(self):
+        self.connection.close()
+
+    def plan_for(self, change, text):
+        return dict(school_folded=[dict(refs=['message:fiction-wx:9'], change=change, at=NOW.isoformat(),
+                                        originals=[dict(ref='message:fiction-wx:9', text=text,
+                                                        time='2026-11-04T16:00:00+08:00')])])
+
+    def test_action_source_and_day_after_acceptance(self):
+        plan = self.plan_for('update', '数学《每日练习》第26页只做第1—3题，第4题不做。')
+        agent._school_accept_fold(self.store, dict(id='agent-card'), plan)
+        task = self.connection.execute("SELECT * FROM manual_tasks WHERE id='TASK-1'").fetchone()
+        self.assertIn('第4题不做', task['action'])
+        self.assertIn('后到原文', task['source'])
+        self.assertIn('2026-11-04 16:00', task['source'])
+        self.assertIn('只做第1—3题', task['source'])
+        # A replacement is a readable note, never a cited message line: the agenda must not read the old range as a day role.
+        self.assertNotIn('\nmessage:fiction-wx:9', '\n' + task['source'])
+
+    def test_a_reminder_is_still_cited_as_a_message(self):
+        plan = self.plan_for('same', '数学《每日练习》第26页1—3题，今晚做，周五交。')
+        agent._school_accept_fold(self.store, dict(id='agent-card'), plan)
+        task = self.connection.execute("SELECT * FROM manual_tasks WHERE id='TASK-1'").fetchone()
+        self.assertIn('message:fiction-wx:9', task['source'])
+
+    def test_the_note_carries_words_and_time_on_both_paths(self):
+        note = agent._school_fold_note(('message:fiction-wx:9', '只做第1—3题，第4题不做。', 'update',
+                                        '2026-11-04T16:00:00+08:00'))
+        self.assertTrue(note.startswith(agent._SCHOOL_FOLD_NOTE))
+        self.assertIn('2026-11-04 16:00', note)
+        self.assertIn('只做第1—3题', note)
+        self.assertFalse(note.startswith('message:'))
+
+    def test_a_second_acceptance_does_not_duplicate_lines(self):
+        plan = dict(school_folded=[folded('same')])
+        agent._school_accept_fold(self.store, dict(id='agent-card'), plan)
+        once = self.connection.execute("SELECT action,source FROM manual_tasks WHERE id='TASK-1'").fetchone()
+        agent._school_accept_fold(self.store, dict(id='agent-card'), plan)
+        twice = self.connection.execute("SELECT action,source FROM manual_tasks WHERE id='TASK-1'").fetchone()
+        self.assertEqual(once['action'], twice['action'])
+        self.assertEqual(once['source'], twice['source'])
+
+
+if __name__ == '__main__':
+    unittest.main()
