+/// 日视图的「明后天」不再占一列，改成标题下的一行预告条：`明后天 N 件 · 前两条标题` + 右侧「看明天 ›」。
+/// 可见文本只放前两条标题（不再露「即将/待补」内部标签）；完整清单文本放在 `upcoming` 探针上，供原生验收读。
+struct UpcomingStrip: View {
+    @ObservedObject var store: WorkspaceStore
+    let count: Int
+    /// 可见摘要：前两条标题用「、」拼，超过两条时已带「等」。
+    let titles: String
+    /// `upcoming` 探针文本（完整明后天清单，与原来同一串）。
+    let line: String
+    let hint: String
+    let next: () -> Void
+
+    var body: some View {
+        HStack(spacing: 8) {
+            Text("明后天 \(count) 件")
+                .font(.system(size: 12, weight: .semibold))
+                .foregroundStyle(Palette.ink2)
+                .lineLimit(1)
+                .fixedSize()
+                .probe("board-upcoming-count", text: hint)
+            if !titles.isEmpty {
+                Text("· " + titles)
+                    .font(.system(size: 12))
+                    .foregroundStyle(Palette.muted)
+                    .lineLimit(1)
+                    .truncationMode(.tail)
+                    .help(titles)
+            }
+            Spacer(minLength: 8)
+            Button(action: next) {
+                HStack(spacing: 3) {
+                    Text("看明天")
+                    Image(systemName: "chevron.right")
+                        .font(.system(size: 9, weight: .semibold))
+                }
+                .font(.system(size: 12))
+                .foregroundStyle(Palette.ink2)
+                .padding(.horizontal, 10)
+                .frame(minHeight: 28)
+                .contentShape(Capsule())
+            }
+            .buttonStyle(.plain)
+            .background(Capsule().fill(Palette.paper2))
+            .overlay(Capsule().strokeBorder(Palette.line, lineWidth: 1))
+            .help("看明天的清单")
+        }
+        .padding(.horizontal, 12)
+        .padding(.vertical, 7)
+        .frame(maxWidth: .infinity, minHeight: 36, alignment: .leading)
+        .background(RoundedRectangle(cornerRadius: 10, style: .continuous).fill(Palette.card))
+        .overlay(RoundedRectangle(cornerRadius: 10, style: .continuous).strokeBorder(Palette.line, lineWidth: 1))
+        .probe("upcoming", text: line)
+    }
+}
+
