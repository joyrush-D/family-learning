+.grove3 .grove-upcoming-strip{display:flex;align-items:center;gap:8px;box-sizing:border-box;width:100%;height:38px;margin:0 0 10px;padding:0 10px;background:var(--g-surface);border:1px solid var(--g-line);border-radius:10px;font-size:12px;line-height:1.3;color:var(--g-ink2);overflow:hidden}
