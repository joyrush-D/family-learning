diff --git a/workbench.css b/workbench.css
index d2e67a4..84b71fe 100644
--- a/workbench.css
+++ b/workbench.css
@@ -1081,3 +1081,174 @@ body.grove-wide[data-page="home"] aside nav.grove-tabs button:hover{
  .grove3,.grove3 .grove-board,.grove3 .grove-board-scroll,.grove3 .grove-list-head{max-width:100%;min-width:0;overflow-x:clip}
