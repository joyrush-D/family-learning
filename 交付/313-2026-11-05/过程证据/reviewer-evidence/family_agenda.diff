+def _plain(text):
+    """The words of a line for comparison only: width, case, blanks and punctuation do not make a repeat; never shown."""
+    text=unicodedata.normalize('NFKC',str(text or '')).lower()
+    return ''.join(ch for ch in text if not ch.isspace() and not unicodedata.category(ch).startswith('P'))
+
+
+def _coverage(part,whole):
+    """How much of part's own words whole also has, counted as a multiset (完成《每日练习》 covers 完成英语《每日练习》)."""
+    if not part:return 0.0
+    left=collections.Counter(whole);seen=0
+    for ch in part:
+        if left.get(ch,0):left[ch]-=1;seen+=1
+    return seen/len(part)
+
+
+def _title_prefix_removed(line,title):
+    """C4: the opening of a line that is the title's own words reads once, in the title.
+
+    A prefix is only taken at a spoken punctuation mark (：，；。), never inside 《》 or brackets; it must be long enough
+    for this title (60%), covered by the title almost word for word (90%), and end on a title word, so a line that adds
+    a new word at the cut (完成练习册第18页… has 完成 of its own) keeps the whole line. Returns (rest,True) when taken;
+    rest may be empty (the line only retold the title) and then the whole line is left out."""
+    title=_plain(title)
+    if not title:return line,False
+    cuts=sorted({n for n,ch in enumerate(line) if ch in '：:，,；;。.'}|{len(line)},reverse=True)
+    for cut in cuts:
+        prefix=line[:cut].strip();rest=line[cut+1:].strip() if cut<len(line) else ''
+        part=_plain(prefix)
+        if not part or len(part)<max(2,0.6*len(title)):continue
+        if _coverage(part,title)<_TITLE_PREFIX:continue
