+def _clause_covered(part,shown):
+    """C2/C5: this clause says nothing the shown clauses do not already show: the same words, a shorter form of one
+    (做完放进英语夹 for 做完放进英语夹里), or one so close that only wording differs. An extension (明天早上交练习册
