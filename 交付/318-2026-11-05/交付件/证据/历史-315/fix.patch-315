+ .grove3 .grove-bar.is-phone .child-filters button::before{content:"";position:absolute;left:0;right:0;top:50%;height:26px;transform:translateY(-50%);border-radius:999px;background:var(--g-surface,#fffdf8);border:1px solid var(--g-line,#e5dfd1);z-index:-1}
+ .grove3 .grove-bar.is-phone .child-filters button[aria-pressed="true"]::before{background:var(--g-accent,#2f5d4b);border-color:var(--g-accent,#2f5d4b)}
+ .grove3 .grove-bar.is-phone .child-filters button[aria-pressed="true"]{color:#fff}
+ .grove3 .grove-bar.is-phone .grove-bar-main{overflow:visible}
+ .grove3 .grove-bar.is-phone .grove-bar-daybtn{position:relative!important;height:44px!important;min-height:44px!important;margin:-10px 0!important;display:inline-flex!important;align-items:center;justify-content:center;padding:0 6px!important}
+ .grove3 .grove-cal-top #today-courses[data-schedule="none"]{display:none!important}
+ .grove3 .grove-chips-row .grove-chip[data-page="calendar"]{white-space:nowrap}
+}
+
+/* Build 314 视觉关：修复 site-nav 通用规则误伤「日历 tabs」（.grove-tabs 本身是 <nav>，被 aside nav button 命中压到 30/36px）。
+   用更高优先级把 tabs 按钮钉回 44px，site nav 的四项不受影响。 */
