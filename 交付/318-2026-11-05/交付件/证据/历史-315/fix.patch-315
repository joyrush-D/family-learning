+_FOLLOW_UP_LINE = re.compile(r'^(后到更正原文|后到补充原文|后到提醒原文|先前提醒|取消依据|后到原文)\s*(?:（([^）]*)）)?\s*[：:]\s*(.*)$')
+_FOLLOW_UP_LABEL = {'后到更正原文':'更正','后到补充原文':'补充','后到提醒原文':'提醒','先前提醒':'先前提醒','取消依据':'取消','后到原文':'提醒'}
