+ .grove3 .grove-chips-row .grove-set,.grove3 .grove-chips-row .grove-chip{position:relative;height:44px!important;min-height:44px!important;border:0!important;background:transparent!important;box-shadow:none!important;padding:0 8px!important;display:inline-flex;align-items:center;gap:4px;font-size:11px;color:var(--g-ink2,#565147)}
+ .grove3 .grove-chips-row .grove-set::before,.grove3 .grove-chips-row .grove-chip::before{content:"";position:absolute;left:0;right:0;top:50%;height:28px;transform:translateY(-50%);border-radius:999px;background:var(--g-surface,#fffdf8);border:1px solid var(--g-line,#e5dfd1);z-index:-1}
+ .grove3 .grove-chips-row .grove-set.is-on::before{background:var(--g-accent,#2f5d4b);border-color:var(--g-accent,#2f5d4b)}
+ .grove3 .grove-chips-row .grove-set.is-on{color:#fff}
